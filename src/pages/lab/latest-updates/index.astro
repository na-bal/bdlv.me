---
import PageLayout from "../../../layouts/PageLayout.astro";
import { historicalChangelog, type Line } from "../../../data/changelog";

const COVER = "/lab/latest-updates/images/cover.svg";

interface MetaModule {
  meta: {
    title: string;
    description: string;
    date: Date;
    draft?: boolean;
  };
}

// Подбираем все эксперименты из соседних папок /lab/*/ — они автоматически
// попадут в текущую версию changelog'а, чтобы не править HTML руками.
const labMetas = import.meta.glob<MetaModule>("../*/_meta.ts", { eager: true });

interface Experiment {
  slug: string;
  title: string;
  date: Date;
  url: string;
}

const experiments: Experiment[] = Object.entries(labMetas)
  .map(([p, mod]) => {
    // путь вида "../cactus/_meta.ts" или "./_meta.ts" — берём предпоследний
    // сегмент (имя папки эксперимента); для собственного файла страницы это
    // даст "." или пустую строку, которые отсекаем фильтром.
    const segments = p.split("/").filter(Boolean);
    const folder = segments[segments.length - 2] ?? "";
    return {
      slug: folder,
      title: mod.meta.title,
      date: mod.meta.date,
      url: `/lab/${folder}/`,
    };
  })
  .filter((e) => /^[a-z0-9-]+$/i.test(e.slug) && e.slug !== "latest-updates")
  .sort((a, b) => b.date.getTime() - a.date.getTime());

function fmtShort(d: Date) {
  return d.toLocaleDateString("ru-RU", {
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
  });
}

function fmtFull(d: Date) {
  return d.toLocaleDateString("ru-RU", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}

const buildDate = fmtFull(new Date());

function expToLine(e: Experiment): Line {
  return {
    kind: "plain",
    html: `<span class="prompt">&gt;&gt;&gt;</span> Добавлен проект <a href="${e.url}">«${e.title}»</a> <span class="dim">(${fmtShort(e.date)})</span>`,
  };
}

// Раскручиваем все строки из исторических версий, и сразу после заголовка
// версии с injectExperiments=true вставляем авто-собранные эксперименты.
const allLines: Line[] = [];
for (const entry of historicalChangelog) {
  for (const line of entry.lines) {
    allLines.push(line);
    if (
      entry.injectExperiments &&
      line.kind === "input" &&
      line.text.startsWith(`BDLV ${entry.version}`)
    ) {
      for (const exp of experiments) {
        allLines.push(expToLine(exp));
      }
    }
  }
}
allLines.push({ kind: "spacer" });
allLines.push({
  kind: "plain",
  html: `<span class="dim">[Последний билд: ${buildDate}]</span>`,
});

// ASCII-арт в самом конце: уточка-маскот, волна, логотип BDLV.ME (figlet Standard).
// Каждый блок — отдельный `<span data-ty="">` чтобы термынал вставлял их по очереди.
const ASCII_DUCK = `       __
   ___( o)>
   \\ <_. )
    \`---'`;

const ASCII_WAVE = `~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~`;

const ASCII_BDLV = ` ____  ____  _ __     __     __  __ _____
| __ )|  _ \\| |\\ \\   / /  _ |  \\/  | ____|
|  _ \\| | | | | \\ \\ / /  (_)| |\\/| |  _|
| |_) | |_| | |__\\ V /      | |  | | |___
|____/|____/|_____\\_/       |_|  |_|_____|`;
---

<PageLayout
  title="Последние обновления — BDLV.me"
  description="Псевдотерминал, который построчно печатает changelog сайта. Обновляется автоматически при каждом деплое."
  ogImage={COVER}
  ogType="article"
>
  <h1 class="visually-hidden">Последние обновления</h1>

  <div class="terminal-window">
    <div class="terminal-chrome" aria-hidden="true">
      <div class="terminal-dots">
        <span class="terminal-dot terminal-dot--red"></span>
        <span class="terminal-dot terminal-dot--yellow"></span>
        <span class="terminal-dot terminal-dot--green"></span>
      </div>
      <div class="terminal-title">bdlv@me &mdash; zsh</div>
    </div>

    <div class="terminal-body">
      <div id="termynal" data-termynal data-ty-typeDelay="20" data-ty-lineDelay="160">
        {
          allLines.map((line) => {
            if (line.kind === "spacer") return <span data-ty="" />;
            if (line.kind === "progress") return <span data-ty="progress" />;
            if (line.kind === "plain") return <span data-ty="" set:html={line.html} />;
            // input
            if (line.prompt) {
              return (
                <span data-ty="input" data-ty-prompt={line.prompt}>
                  {line.text}
                </span>
              );
            }
            return <span data-ty="input">{line.text}</span>;
          })
        }
        <span data-ty="" class="ascii-line"><pre class="ascii-art ascii-art--duck">{ASCII_DUCK}</pre></span>
        <span data-ty="" class="ascii-line"><pre class="ascii-art ascii-art--wave">{ASCII_WAVE}</pre></span>
        <span data-ty="" class="ascii-line"><pre class="ascii-art ascii-art--logo">{ASCII_BDLV}</pre></span>
      </div>
      <span class="terminal-end-cursor" aria-hidden="true">▋</span>
    </div>
  </div>

  <script is:inline src="/lab/latest-updates/termynal.js"></script>
</PageLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .terminal-window {
    max-width: 92rem;
    margin: 3rem auto 6rem;
    background: #0e0e10;
    border-radius: 10px;
    box-shadow: 0 28px 60px -20px rgba(0, 0, 0, 0.55);
    overflow: hidden;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  .terminal-chrome {
    position: relative;
    display: flex;
    align-items: center;
    background: linear-gradient(#2a2a30, #1a1a1f);
    padding: 0.9rem 1.3rem;
    border-bottom: 1px solid #2a2a30;
  }

  .terminal-dots {
    display: flex;
    gap: 0.6rem;
  }

  .terminal-dot {
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    display: block;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
  }

  .terminal-dot--red {
    background: #ff5f57;
  }
  .terminal-dot--yellow {
    background: #febc2e;
  }
  .terminal-dot--green {
    background: #28c840;
  }

  .terminal-title {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: #8a8a8a;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }

  .terminal-body {
    position: relative;
    background: #0e0e10;
    color: #ffb000;
    padding: 2rem 2.4rem 1.5rem;
    font-size: 1.5rem;
    line-height: 1.75;
    min-height: 60vh;
  }

  /* CRT-сканлайны: лёгкая горизонтальная рябь поверх содержимого. */
  .terminal-body::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.22) 2px,
      rgba(0, 0, 0, 0.22) 3px
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Лёгкая виньетка по краям — тоже под CRT-эстетику. */
  .terminal-body::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
    z-index: 2;
  }

  #termynal {
    position: relative;
    z-index: 1;
    text-shadow: 0 0 7px rgba(255, 176, 0, 0.35);
  }

  #termynal :global(a) {
    color: #79c0ff;
    text-decoration: underline;
    text-decoration-color: rgba(121, 192, 255, 0.45);
  }

  #termynal :global(a:hover) {
    color: #aedafc;
  }

  #termynal :global(.prompt) {
    color: #888;
    margin-right: 0.4em;
  }

  #termynal :global(.dim) {
    color: #6a6a6a;
  }

  :global([data-ty]) {
    display: block;
    white-space: pre-wrap;
    word-break: break-word;
  }

  :global([data-ty="input"])::before {
    color: #888;
    content: "$ ";
  }

  :global([data-ty][data-ty-prompt])::before {
    content: attr(data-ty-prompt) " ";
    color: #888;
  }

  :global([data-ty=""]:empty) {
    height: 1em;
  }

  :global([data-ty][data-ty-cursor])::after {
    content: attr(data-ty-cursor);
    font-weight: bold;
    margin-left: 0.15em;
    animation: terminal-blink 1s steps(2) infinite;
  }

  /* ASCII-арт. Внешний span (.ascii-line) центрирует, внутренний <pre>
     держит свою ширину как inline-block и сохраняет все пробелы (white-space: pre).
     Усиление через !important — родительский селектор [data-ty] задаёт
     pre-wrap/word-break, которые ломают выравнивание моноспейсного арта. */
  .ascii-line {
    display: block !important;
    text-align: center;
    margin-top: 1.6em !important;
    white-space: normal !important;
    word-break: normal !important;
  }

  .ascii-art {
    display: inline-block;
    margin: 0;
    padding: 0;
    text-align: left;
    white-space: pre !important;
    word-break: normal !important;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 1.3rem;
    line-height: 1.1;
    color: #ffb000;
    text-shadow: 0 0 7px rgba(255, 176, 0, 0.4);
  }

  .ascii-art--duck {
    font-size: 1.5rem;
  }

  .ascii-art--wave {
    margin-top: 0.4em;
    color: #c2873a;
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .ascii-art--logo {
    font-size: 1.15rem;
    margin-top: 0.6em;
  }

  @media (max-width: 750px) {
    .ascii-art {
      font-size: 1.1rem;
    }
    .ascii-art--duck {
      font-size: 1.2rem;
    }
    .ascii-art--logo {
      font-size: 0.85rem;
    }
  }

  .terminal-end-cursor {
    position: relative;
    z-index: 1;
    display: inline-block;
    color: #ffb000;
    font-size: 1.5rem;
    padding-left: 0.1em;
    text-shadow: 0 0 7px rgba(255, 176, 0, 0.35);
    animation: terminal-blink 1s steps(2) infinite;
  }

  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 750px) {
    .terminal-body {
      padding: 1.4rem 1.4rem 1rem;
      font-size: 1.3rem;
      min-height: 70vh;
    }
    .terminal-title {
      font-size: 1.1rem;
    }
  }
</style>
