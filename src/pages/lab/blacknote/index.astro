---
import RootLayout from "../../../layouts/RootLayout.astro";

const COVER = "/lab/blacknote/images/cover.svg";
---

<RootLayout
  title="BlackNote — BDLV.me"
  description="Чёрная страница на весь экран. Кликаешь — пишешь. Текст хранится в вашем браузере и переживает закрытие вкладки. Никакого облака."
  ogImage={COVER}
  ogType="article"
  showHeader={false}
  showFooter={false}
>
  <h1 class="visually-hidden">BlackNote</h1>

  <main
    class="black-note"
    contenteditable="true"
    spellcheck="false"
    aria-label="BlackNote — приватная страница для записей"></main>

  <script is:inline>
    (function () {
      const STORAGE_KEY = "bdlv.blacknote.content";
      const LEGACY_KEY = "BlackNoteContent";
      const DEBOUNCE_MS = 200;

      const board = document.querySelector("main.black-note");
      if (!board) return;

      function loadInitial() {
        // Миграция со старого ключа: если новый пуст, а старый есть — копируем
        // и убираем старый, чтобы не плодить дубль.
        let saved = null;
        try {
          saved = localStorage.getItem(STORAGE_KEY);
          if (saved === null) {
            const legacy = localStorage.getItem(LEGACY_KEY);
            if (legacy !== null) {
              saved = legacy;
              localStorage.setItem(STORAGE_KEY, legacy);
              localStorage.removeItem(LEGACY_KEY);
            }
          }
        } catch {
          // localStorage недоступен (приват-режим или квота) — просто молча
          // продолжаем без сохранения.
        }
        if (saved !== null) board.innerHTML = saved;
        updatePlaceholderClass();
      }

      function updatePlaceholderClass() {
        const hasText = (board.textContent || "").trim().length > 0;
        board.classList.toggle("has-content", hasText);
      }

      let saveTimer = null;
      function flushSave() {
        if (saveTimer) {
          clearTimeout(saveTimer);
          saveTimer = null;
        }
        try {
          localStorage.setItem(STORAGE_KEY, board.innerHTML);
        } catch {
          // квота / приватка — ничего не делаем.
        }
      }
      function scheduleSave() {
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(flushSave, DEBOUNCE_MS);
      }

      board.addEventListener("input", () => {
        scheduleSave();
        updatePlaceholderClass();
      });
      board.addEventListener("focus", updatePlaceholderClass);
      board.addEventListener("blur", () => {
        flushSave();
        updatePlaceholderClass();
      });

      // Закрытие вкладки/перезагрузка/смена страницы могут случиться раньше,
      // чем дебаунс успеет дописать. Флашим синхронно на любое такое событие.
      window.addEventListener("pagehide", flushSave);
      window.addEventListener("beforeunload", flushSave);

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadInitial);
      } else {
        loadInitial();
      }
    })();
  </script>
</RootLayout>

<style is:global>
  /* Полный fullscreen, без отступов от RootLayout. RootLayout по умолчанию
     задаёт `body { display: flex; flex-direction: column }` — нам это окей,
     `main.black-note` сам растягивается на оставшуюся высоту через flex-grow. */
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #000;
  }
</style>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Подсказка для пустого состояния. CSS `::before` content скрывается, как
     только в .black-note появляется текст (.has-content) или фокус. */
  main.black-note::before {
    content: "Текст хранится в вашем браузере. Даже после закрытия страницы. Он доступен только вам.\A Кликни сюда и начни писать.\A 🦆";
    color: #888;
    font-size: 2rem;
    white-space: pre-wrap;
    display: block;
    pointer-events: none;
  }

  main.black-note.has-content::before,
  main.black-note:focus::before {
    content: none;
  }

  .black-note {
    /* Растягиваемся на всю высоту окна. RootLayout задаёт body как flex-column
       без header/footer — этот main забирает всё доступное место. */
    flex: 1 1 auto;
    min-height: 100vh;

    margin: 0;
    background-color: #000;
    color: #fff;
    caret-color: #fff;
    width: 100%;
    box-sizing: border-box;
    padding: 2rem;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 3rem;
    line-height: 1.4;
    outline: none;
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Розовое выделение — единственный цветной акцент на странице. */
  .black-note ::selection {
    background-color: #ffb3ce;
    color: #000;
  }

  .black-note ::-moz-selection {
    background-color: #ffb3ce;
    color: #000;
  }

  @media (max-width: 600px) {
    .black-note {
      padding: 1rem;
      font-size: 2rem;
    }
    main.black-note::before {
      font-size: 1.4rem;
    }
  }
</style>
