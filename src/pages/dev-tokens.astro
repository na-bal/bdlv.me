---
// DEV-only: визуальная проверка токенов и шрифтов.
// Удалить при switch-коммите в Phase 2.
import "../styles/fonts.css";
import "../styles/tokens.css";

const swatches = [
  { name: "--color-bg", value: "#ffffff", border: true },
  { name: "--color-text", value: "#000000" },
  { name: "--color-border", value: "#000000" },
  { name: "--color-link", value: "#0645AD" },
  { name: "--color-link-hover", value: "#f41224" },
  { name: "--color-accent-pink", value: "#FEB3CE" },
  { name: "--color-accent-yellow", value: "#FFC300" },
  { name: "--color-surface-muted", value: "rgb(233, 233, 233)" },
];

const sizes = [
  { name: "--font-size-sm", token: "1.4rem" },
  { name: "--font-size-base", token: "1.6rem" },
  { name: "--font-size-md", token: "1.9rem" },
  { name: "--font-size-lg", token: "2.0rem" },
  { name: "--font-size-xl", token: "2.4rem" },
  { name: "--font-size-2xl", token: "3.4rem" },
  { name: "--font-size-3xl", token: "3.5rem" },
  { name: "--font-size-4xl", token: "4.8rem" },
];

const spaces = [
  "--space-1",
  "--space-2",
  "--space-3",
  "--space-4",
  "--space-5",
  "--space-6",
  "--space-7",
  "--space-8",
  "--space-9",
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Tokens preview — bdlv.me</title>
  </head>
  <body>
    <main>
      <h1>Tokens preview</h1>
      <p>Эта страница временная. Удалится при переключении в Phase 2.</p>

      <section>
        <h2>Палитра</h2>
        <ul class="swatches">
          {
            swatches.map((s) => (
              <li>
                <span
                  class="chip"
                  style={`background:${s.value};${s.border ? "border:1px solid #000;" : ""}`}
                />
                <code>{s.name}</code>
                <span class="value">{s.value}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Roboto (body)</h2>
        <p style="font-family: var(--font-body); font-weight: 400">
          400 — Съешь же ещё этих мягких французских булок, да выпей чаю. The
          quick brown fox jumps over the lazy dog.
        </p>
        <p style="font-family: var(--font-body); font-weight: 500">
          500 — Съешь же ещё этих мягких французских булок, да выпей чаю.
        </p>
        <p style="font-family: var(--font-body); font-weight: 700">
          700 — Съешь же ещё этих мягких французских булок, да выпей чаю.
        </p>
      </section>

      <section>
        <h2>Roboto Slab (display)</h2>
        <p style="font-family: var(--font-display); font-weight: 400">
          400 — Съешь же ещё этих мягких французских булок.
        </p>
        <p style="font-family: var(--font-display); font-weight: 500">
          500 — Съешь же ещё этих мягких французских булок.
        </p>
        <p style="font-family: var(--font-display); font-weight: 700">
          700 — Съешь же ещё этих мягких французских булок.
        </p>
      </section>

      <section>
        <h2>Размеры</h2>
        <ul class="sizes">
          {
            sizes.map((s) => (
              <li>
                <span style={`font-size: var(${s.name})`}>Aa Яя 123</span>
                <code>{s.name}</code>
                <span class="value">{s.token}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Spacing</h2>
        <ul class="spacings">
          {
            spaces.map((name) => (
              <li>
                <span class="bar" style={`width: var(${name})`} />
                <code>{name}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Ссылки</h2>
        <p>
          <a href="#">Обычная ссылка (используйте hover)</a>
        </p>
      </section>
    </main>

    <style>
      main {
        max-width: 80rem;
        padding: var(--space-5);
        font-family: var(--font-body);
      }

      h1 {
        font-family: var(--font-display);
        font-size: var(--font-size-3xl);
      }

      h2 {
        font-family: var(--font-display);
        font-size: var(--font-size-xl);
        margin-top: var(--space-6);
      }

      section {
        margin-bottom: var(--space-5);
      }

      .swatches {
        list-style: none;
        padding: 0;
        display: grid;
        gap: var(--space-2);
      }
      .swatches li {
        display: grid;
        grid-template-columns: 5rem 22rem 1fr;
        align-items: center;
        gap: var(--space-2);
      }
      .chip {
        display: inline-block;
        width: 4rem;
        height: 4rem;
        border-radius: 0.4rem;
      }

      .sizes {
        list-style: none;
        padding: 0;
      }
      .sizes li {
        display: flex;
        align-items: baseline;
        gap: var(--space-3);
        margin-bottom: var(--space-2);
      }

      .spacings {
        list-style: none;
        padding: 0;
      }
      .spacings li {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-1);
      }
      .bar {
        display: inline-block;
        height: 1.4rem;
        background: var(--color-accent-pink);
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: var(--font-size-sm);
      }
      .value {
        color: var(--color-text);
        opacity: 0.6;
        font-size: var(--font-size-sm);
      }
    </style>
  </body>
</html>
