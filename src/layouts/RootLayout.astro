---
import "../styles/fonts.css";
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** OpenGraph type. Дефолт 'website'. Для /lab/<slug>/ — 'article'. */
  ogType?: "website" | "article" | "profile";
  /** Phase 3: продуктовая зона может рендериться без шапки. */
  showHeader?: boolean;
  /** Phase 3: продуктовая зона может рендериться без подвала. */
  showFooter?: boolean;
  /** robots: noindex для dev/служебных страниц. */
  noindex?: boolean;
}

const {
  title,
  description = "",
  ogImage,
  ogType = "website",
  showHeader = true,
  showFooter = true,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImageAbs = ogImage
  ? new URL(ogImage, Astro.site ?? Astro.url).toString()
  : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Александр Беделев" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}

    <meta name="twitter:card" content={ogImageAbs ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}
  </head>
  <body>
    {showFooter && <div class="rubber-end" aria-hidden="true">Конец</div>}
    <div class:list={["page-stack", { "page-stack--has-footer": showFooter }]}>
      {showHeader && <Header />}
      <slot />
    </div>
    {showFooter && <Footer />}
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    margin: 0;
  }

  html {
    background-color: var(--color-bg);
  }

  /* Пасхалка в rubber-band. Логика:
     - .rubber-end — `position: fixed; bottom: 0` → прибит к низу viewport.
     - Z-index 0 + DOM-порядок ДО footer: footer (тоже z:0, но позже в DOM)
       перекрывает его в обычном режиме.
     - Page-stack (z:1) перекрывает его в средней части экрана.
     - При оттяжке вниз: page-stack и sticky-footer уезжают вверх вместе
       с контентом, fixed-элемент остаётся прибитым к низу viewport → виден.
     - При оттяжке вверх: footer остаётся внизу (sticky bottom:0), перекрывает. */
  .rubber-end {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;

    padding: 1.6rem 0 2.4rem;
    text-align: center;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.2rem;
    font-style: italic;
    color: rgba(0, 0, 0, 0.4);

    pointer-events: none;
    user-select: none;
  }

  /* Белый «лист» с контентом наезжает сверху на радужный sticky-футер.
     Тень кастуется с нижнего края page-stack вниз — это и создаёт эффект
     многослойного наложения. z-index: 1 поверх footer (z-index: 0). */
  .page-stack {
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    min-height: 100vh;
  }

  /* Двухслойная тень: контактная (ближе, плотнее) + атмосферная (дальше, мягче).
     Имитирует реальное освещение — близкий лист даёт чёткую тень,
     рассеянный свет — мягкую дымку дальше. */
  .page-stack--has-footer {
    box-shadow:
      0 4px 8px rgba(0, 0, 0, 0.35),
      0 32px 56px rgba(0, 0, 0, 0.16);
  }
</style>
