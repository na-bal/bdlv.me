---
interface Props {
  src: string;
  alt: string;
  /**
   * Позиция картинки в 12-колоночной сетке.
   * - col3: внутри Grid, на ширину одной ячейки (figure без grid-column).
   * - long: 1/-1, во всю ширину.
   * - inline: 3/span 8 (центральная половина).
   * - inlinestart: 3/span 8.
   * - inline1: 3/span 4 (левая половина).
   * - inline2: 7/span 4 (правая половина).
   * - mininline1: 3/span 3.
   * - mininline2: 6/span 3.
   * - mininlinestart4: 3/span 4.
   * - mininlinestart2: 3/span 2.
   * - factoid: 8/span 3, row span 2.
   */
  variant?:
    | "col3"
    | "long"
    | "inline"
    | "inlinestart"
    | "inline1"
    | "inline2"
    | "mininline1"
    | "mininline2"
    | "mininlinestart4"
    | "mininlinestart2"
    | "factoid";
  width?: number;
  height?: number;
}

const { src, alt, variant = "col3", width, height } = Astro.props;
---

<figure class:list={["article-img", `article-img--${variant}`]}>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
</figure>

<style>
  .article-img {
    overflow: hidden;
    margin: 0;
  }

  .article-img img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Внутри Grid — без grid-column */
  .article-img--col3 {
    margin: 4px;
  }

  .article-img--long {
    grid-column: 1 / -1;
  }

  .article-img--inline,
  .article-img--inlinestart {
    grid-column: 3 / span 8;
  }

  .article-img--inline1 {
    grid-column: 3 / span 4;
  }
  .article-img--inline2 {
    grid-column: 7 / span 4;
  }

  .article-img--mininline1 {
    grid-column: 3 / span 3;
  }
  .article-img--mininline2 {
    grid-column: 6 / span 3;
  }

  .article-img--mininlinestart4 {
    grid-column: 3 / span 4;
  }
  .article-img--mininlinestart2 {
    grid-column: 3 / span 2;
  }

  .article-img--factoid {
    grid-column: 8 / span 3;
    grid-row: span 2;
    align-self: end;
    /* 512px source → не растягиваем больше 280px (≥1.83x для retina). */
    max-width: 280px;
  }

  @media screen and (max-width: 1000px) {
    .article-img--inline,
    .article-img--inlinestart {
      grid-column: 2 / span 10;
    }
    .article-img--inline1 {
      grid-column: 2 / span 6;
    }
    .article-img--inline2 {
      grid-column: 8 / span 6;
    }
    .article-img--mininline1 {
      grid-column: 2 / span 5;
    }
    .article-img--mininline2 {
      grid-column: 7 / span 5;
    }
    .article-img--mininlinestart4 {
      grid-column: 2 / span 6;
    }
    .article-img--mininlinestart2 {
      grid-column: 2 / span 3;
    }
  }

  @media screen and (max-width: 750px) {
    .article-img--inline,
    .article-img--inlinestart {
      grid-column: 1 / -1;
    }
    .article-img--inline1 {
      grid-column: 1 / span 6;
    }
    .article-img--inline2 {
      grid-column: 7 / span 6;
    }
    .article-img--mininline1 {
      grid-column: 1 / span 5;
    }
    .article-img--mininline2 {
      grid-column: 6 / span 5;
    }
    .article-img--mininlinestart4 {
      grid-column: 1 / span 9;
    }
    .article-img--mininlinestart2 {
      grid-column: 1 / span 5;
    }
    .article-img--factoid {
      grid-column: 1 / 8;
      grid-row: span 2;
      margin-top: -4rem;
      margin-bottom: -4rem;
    }
  }

  @media screen and (max-width: 450px) {
    .article-img--inline1,
    .article-img--inline2,
    .article-img--mininline1,
    .article-img--mininline2,
    .article-img--mininlinestart4,
    .article-img--mininlinestart2 {
      grid-column: 1 / -1;
    }
    .article-img--factoid {
      grid-column: 1 / 10;
      grid-row: span 1;
      margin-top: -3rem;
      margin-bottom: -3rem;
    }
  }
</style>
