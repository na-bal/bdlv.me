---
import RootLayout from "./RootLayout.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  /** На всю ширину окна (как старый сайт). Лаб-страницы — fluid. */
  fluid?: boolean;
}

const { title, description, ogImage, ogType, noindex, fluid = false } = Astro.props;
---

<RootLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
>
  <main class:list={["page-main", { "page-main--fluid": fluid }]}>
    <slot />
  </main>
</RootLayout>

<style>
  .page-main {
    flex: 1 0 auto;
    width: 100%;
    background: var(--color-bg);
    position: relative;
    z-index: 1;
    /* Стандарт: центрированный контейнер с боковыми отступами. */
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-7);
  }

  /* Fluid: на всю ширину viewport. Без grid — Yandex Maps (WebGL) глючит
     внутри grid-контейнера в некоторых движках. Центрирование внутреннего
     контента возьмут на себя дочерние блоки (.new-grid имеет width: 100%). */
  .page-main.page-main--fluid {
    max-width: none;
    margin: 0;
    padding: 1rem;
  }

  @media screen and (max-width: 750px) {
    .page-main {
      padding: 0 var(--space-3) var(--space-5);
    }
    .page-main.page-main--fluid {
      padding: 1rem;
    }
  }
</style>
